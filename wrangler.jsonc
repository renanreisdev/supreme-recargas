{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supreme-recargas",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2025-05-05",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/acompanhar/*"]
  },
  "routes": [
    {
      "pattern": "appos.supremeinformatica.com.br",
      "custom_domain": true
    }
  ]
}
